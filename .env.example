# ==============================================================================
# Vaultly Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local containing real credentials to Git!
# ==============================================================================

# ── Database (MariaDB / MySQL) ────────────────────────────────────────────────
DATABASE_URL=mysql://root:password@127.0.0.1:3306/vaultly

# ── Better-Auth ───────────────────────────────────────────────────────────────
# Random string at least 32 characters long used to sign session cookies & tokens
BETTER_AUTH_SECRET=your_betterauth_secret_key_at_least_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (Optional) ───────────────────────────────────────────────────
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe Payments (Optional) ────────────────────────────────────────────────
# From Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Crypto Payments via NOWPayments ───────────────────────────────────────────
# From NOWPayments Dashboard (or account-sandbox.nowpayments.io for testing)
NOWPAYMENTS_SANDBOX=true
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ── Resend Email Service (Optional) ───────────────────────────────────────────
# From Resend.com -> API Keys (used for password resets and verification emails)
RESEND_API_KEY=re_...

# ── Discord OAuth & Bot Configuration (Optional) ──────────────────────────────
# From Discord Developer Portal -> Applications -> General Information & Bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=
DISCORD_APPROVAL_WEBHOOK_URL=

# ── Super Admin Master Access ─────────────────────────────────────────────────
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PASSWORD=change_this_super_admin_password

# ── Public App Configuration ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
